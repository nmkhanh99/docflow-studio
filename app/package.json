{
  "name": "@docflow-studio/app",
  "version": "0.1.0",
  "private": true,
  "description": "DocFlow Studio — Ứng dụng Desktop biên tập và tự động hóa tài liệu DOCX theo kiến trúc Ports & Adapters",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
